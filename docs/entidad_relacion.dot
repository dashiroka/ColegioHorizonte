digraph G { rankdir=LR; graph[bgcolor=white, pad=.1, nodesep=.3,ranksep=.7]; node[shape=record,style=filled,fillcolor="#F8FAFC",fontname="DejaVu Sans",fontsize=10,color="#94A3B8"]; estudiantes[label="Estudiante|id / tipo / documento"]; acudientes[label="Acudiente|id / documento"]; vinculos[label="EstudianteAcudiente|estudiante_id / acudiente_id"]; grupos[label="Grupo|grado_id / jornada"]; grados[label="Grado|id / nombre"]; periodos[label="PeriodoAcademico|id / fechas"]; matriculas[label="Matricula|estudiante_id / grupo_id / periodo_id"]; obligaciones[label="Obligacion|matricula_id / concepto_id / saldo"]; conceptos[label="ConceptoCobro|tipo / valor_base"]; pagos[label="Pago|referencia / total / estado"]; detalles[label="DetallePago|pago_id / obligacion_id / valor"]; auditoria[label="Auditoria|usuario_id / accion"]; usuarios[label="Django User / Group|autenticación / roles"]; estudiantes->matriculas; estudiantes->vinculos; acudientes->vinculos; grados->grupos; grupos->matriculas; periodos->matriculas; matriculas->obligaciones; conceptos->obligaciones; obligaciones->detalles; pagos->detalles; usuarios->pagos; usuarios->auditoria; }
